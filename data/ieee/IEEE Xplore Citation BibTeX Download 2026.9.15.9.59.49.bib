  abstract={This Special Issue contains a collection of invitation-only extensions based on papers presented at the Optical Networks and Systems Symposium at IEEE GLOBECOM held 4–8 December 2023 in Kuala Lumpur, Malaysia. We present a brief introduction followed by an overview of each of the papers.},
  keywords={Special issues and sections;Optical fiber networks;Meetings;Optical fiber communication},
  doi={10.1364/JOCN.539472},
