  doi={10.1109/MPER.1981.5511609},
  ISSN={1558-1705},
  month={June},}@ARTICLE{8940921,
  author={Liu, Junyong and Gao, Hongjun and Ma, Zhao and Li, Yuanxi},
  journal={Journal of Modern Power Systems and Clean Energy}, 
