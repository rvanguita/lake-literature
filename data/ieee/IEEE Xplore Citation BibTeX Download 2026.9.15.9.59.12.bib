@ARTICLE{8819916,
  author={Emmanuel, Michael and Giraldez, Julieta},
  journal={IEEE Access}, 
  title={Net Electricity Clustering at Different Temporal Resolutions Using a SAX-Based Method for Integrated Distribution System Planning}, 
