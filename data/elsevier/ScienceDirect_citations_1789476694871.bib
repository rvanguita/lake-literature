@article{SUN2025117949,
title = {Comprehensive benefit assessment of photovoltaic and energy storage projects in incremental distribution networks under multiple coupled markets},
journal = {Journal of Energy Storage},
volume = {133},
pages = {117949},
year = {2025},
issn = {2352-152X},
doi = {https://doi.org/10.1016/j.est.2025.117949},
url = {https://www.sciencedirect.com/science/article/pii/S2352152X25026623},
author = {Xiaorong Sun and Liuyu Lin and Shuang Wu and Xiaomeng Zhai and Chenhao Jin and Xueping Pan},
keywords = {Investment benefit assessment, Multiple coupled markets, Incremental distribution network, Shared energy storage, System dynamics},
abstract = {With the rapid development of wind power and photovoltaic, energy storage systems have become a key component for the reliable and stable operation of modern power systems. How to evaluate the cost of photovoltaic and energy storage (PV-ES) projects and realize the profitability of investment has become an urgent problem. This paper takes the incremental distribution network (IDN) as the research object, and establishes a PV-ES synergistic investment and operation relationship based on shared storage and the electricity-carbon-green certificate market in response to the trend of continuous improvement of the carbon market and the green certificate market, as well as the new investment situation of the increasing share of distributed energy in the IDN. Meanwhile, considering the scenarios under multiple coupled markets, this study explores the feedback mechanism of IDN investors investing in PV-ES projects and constructs a comprehensive benefit evaluation module based on system dynamics. By proposing a benefit assessment model for IDN investment in constructing PV-ES projects, impacts of different policies and shared storage models on investment benefits are investigated. Results show that under the combined effect of composite policies and shared energy storage operation models, investment financial benefits of IDN investors are significantly improved with significant advantages in reducing carbon emissions and increasing renewable energy consumption.}
}
@article{YUZHI20121517,
