@article{BEHERA2015214,
title = {A review on optimization algorithms and application to wind energy integration to grid},
journal = {Renewable and Sustainable Energy Reviews},
volume = {48},
pages = {214-227},
year = {2015},
issn = {1364-0321},
doi = {https://doi.org/10.1016/j.rser.2015.03.066},
url = {https://www.sciencedirect.com/science/article/pii/S1364032115002191},
author = {Sasmita Behera and Subhrajit Sahoo and B.B. Pati},
keywords = {Optimization algorithms, Wind farm design for sitting, Optimal placement and sizing of DG, Generation scheduling, PID controller tuning, Control of wind energy conversion system (WECS)},
abstract = {In order to meet power needs, with concern for economics and environment, wind energy conversion is gradually gaining interest as a suitable source of renewable energy. To maximize the power extraction from the wind, optimization techniques are used at the various module of a wind farm starting from wind farm design for siting, sizing, optimal placement and sizing of distributed generation (DG) sources, generation scheduling, tuning of PID controller, control of wind energy conversion system (WECS) etc. This paper mainly focuses on the optimization algorithms (mostly the swarm based) in relation to integration of the wind farm with the grid. The paper here gives a precise idea about different optimization techniques, their advantage and disadvantage with respect to a wind farm. This review will enable the researchers to open the mind to explore possible applications in this field as well as beyond this area.}
}
@article{CARLSON198253,
title = {Time-phased resource allocation for a production/distribution system},
journal = {Engineering Costs and Production Economics},
volume = {6},
pages = {53-58},
year = {1982},
issn = {0167-188X},
doi = {https://doi.org/10.1016/0167-188X(82)90037-4},
url = {https://www.sciencedirect.com/science/article/pii/0167188X82900374},
author = {John G. Carlson},
abstract = {The MRP model and logic yield the time-phased requirements for the several levels in a combined manufacturing/distribution logistics system. With some simplifying assumptions and ignoring batch sizes the time phased requirements and costs can be inserted into a transportation model and an ‘optimum’ production/distribution schedule derived. Real problems, such as described, are often very large so that operational solutions cannot be obtained without an enormous amount of data input and a large and accessible computer. The most viable approaches appear to be those which include the human in the analysis and decision loops. This can be done by utilizing an information system which keeps the data bases current and then process these data on line to produce graphic (Gantt charts) and tabular displays of feasible schedules. These schedules include the constraints of lead times, batch sizes, changeover, etc. which could be judged by an economic measure. Satisficing solutions can thus be obtained from sessions of “what if” where heuristic schedule and allocation rules are tested with an interactive DRP/MRP computer module as described. On occasion or periodically these schedules can be compared to an optimum schedule as computed from a large, mixed integer program if the real problem can be accurately modeled.}
}
@incollection{KUJSZCZYK1986267,
title = {COMPUTER AIDED DESIGN OF ELECTRIC DISTRIBUTION NETWORK},
editor = {P. MARTIN LARSEN and N.E. HANSEN},
booktitle = {Computer Aided Design in Control and Engineering Systems},
publisher = {Pergamon},
pages = {267-270},
year = {1986},
isbn = {978-0-08-032557-6},
doi = {https://doi.org/10.1016/B978-0-08-032557-6.50053-4},
url = {https://www.sciencedirect.com/science/article/pii/B9780080325576500534},
author = {S. Kujszczyk},
abstract = {Electric distribution networks are and essential part of power systems, In Poland system of computer - aided design of HV and MV networks have already been elaborated and put into operation. The system is based on the data base. It is composed of the following data sets:–catalogues, containing the technical and economic parameters of the equipment,–catalogues classifying customers,–data catalogues for reliability calculations,–data for technical and economic calculations,–parameters essential for the computer drawing of designs of electric networks,–numerical representation of the existing networks. The system has a block structure. It has following blocks of programs:–block for writing and maintenance of data sets,–blocks for generating new variants of the network,–blocks for data processing,–blocks for technical and economic calculations,–blocks for drawing,–auxiliary blocks. The system operating in a conversational way enables the user to guide the calculating process as it takes place. The user determines the sequence of performing the respective elements of the calculating process and, after every stage of the calculations, is able to return to any previous stage he chouses. The various calculations are performed in accordance with the user's instructions. These instructions are in the form of instructions in so called problem oriented language, adapted to the needs of the system. Aknowledge of programming and the principles of the operation of computers is not required in using instructions in the language.}
}
@article{SUN2021273,
title = {Generation expansion planning considering efficient linear EENS formulation},
journal = {Global Energy Interconnection},
volume = {4},
number = {3},
pages = {273-284},
year = {2021},
issn = {2096-5117},
doi = {https://doi.org/10.1016/j.gloei.2021.07.004},
url = {https://www.sciencedirect.com/science/article/pii/S2096511721000657},
author = {Donglei Sun and Zhijie Zheng and Shuai Liu and Mingqiang Wang and Yi Sun and Dong Liu},
keywords = {Expected energy not supplied, Generation expansion planning, Linearization methods},
abstract = {Power system equipment outages are one of the most important factors affecting the reliability and economy of power systems. It is crucial to consider the reliability of the planning problems. In this paper, a generation expansion planning (GEP) model is proposed, in which the candidate generating units and energy storage systems (ESSs) are simultaneously planned by minimizing the cost incurred on investment, operation, reserve, and reliability. The reliability cost is computed by multiplying the value of lost load (VOLL) with the expected energy not supplied (EENS), and this model makes a compromise between economy and reliability. Because the computation of EENS makes the major computation impediment of the entire model, a new efficient linear EENS formulation is proposed and applied in a multi-step GEP model. By doing so, the computation efficiency is significantly improved, and the solution accuracy is still desirable. The proposed GEP model is illustrated using the IEEE-RTS system to validate the effectiveness and superiority of the new model.}
}
@article{PATTANAIK2024103559,
title = {A critical review on phasor measurement units installation planning and application in smart grid environment},
journal = {Results in Engineering},
volume = {24},
pages = {103559},
year = {2024},
issn = {2590-1230},
doi = {https://doi.org/10.1016/j.rineng.2024.103559},
url = {https://www.sciencedirect.com/science/article/pii/S2590123024018024},
author = {Vivekananda Pattanaik and Binaya Kumar Malika and Subhasis Panda and Pravat Kumar Rout and Binod Kumar Sahu and Indu Sekhar Samanta and Mohit Bajaj and Vojtech Blazek and Lukas Prokop},
keywords = {Phasor Measurement Units, Micro-PMU, Optimal placement, Observability, State analysis},
abstract = {Monitoring, detection, and measurement are vital in the energy system to facilitate better wide-ranging protection, control, and operation. In this regard, to offer a better operational and dynamic performance, Phasor Measurement Units (PMUs) are the prominent components and most desirable choices for transforming the conventional power system into a smart grid and micro-grid-based system. PMUs provide synchronized phasor measurements of electrical parameters such as current, voltage, and other information related to the system's status. However, one of the significant issues related to PMU placement is to place such that the system is fully observable and achieves better state estimation that has a crucial impact on planning, protection, control, and other factors related to the system's overall performance. This motivates the authors to extensively review the innovative approaches suggested by various authors and present their ideas, advantages, limitations, and untouched research gaps. Secondly, this review elaborates on these techniques’ concepts and mathematical details. Thirdly, various techniques are discussed categorically, starting from classical optimization techniques, heuristic and meta-heuristic-based approaches, hybrid techniques, and advanced methods. Also, the problem formulation for the PMUs placement is expressed, giving importance to the objective function, constraints, variables, and assessment index reflecting the optimality in placement. In addition, the future scope is presented to enlighten the researcher on critical discussions regarding the research gaps and fundamental changes to system topology and operation that must be focused on. In this review article, even though the methodologies are similar in approach, a micro-PMU (µPMU) placement is discussed as more important than the PMUs, looking at the present scenario and application in the distribution sector. This article also focuses on various PMU-related standards and real-time applications.}
}
@article{ZENG2018186,
title = {Hybrid probabilistic-possibilistic approach for capacity credit evaluation of demand response considering both exogenous and endogenous uncertainties},
journal = {Applied Energy},
volume = {229},
pages = {186-200},
year = {2018},
issn = {0306-2619},
doi = {https://doi.org/10.1016/j.apenergy.2018.07.111},
url = {https://www.sciencedirect.com/science/article/pii/S0306261918311462},
author = {Bo Zeng and Xuan Wei and Dongbo Zhao and Chanan Singh and Jianhua Zhang},
keywords = {Demand response, Capacity credit, Operating reserve, Generation capacity adequacy, Probabilistic-possibilistic modeling, Endogenous uncertainties},
abstract = {As a featured smart-grid technology, demand response (DR) provides utility companies with unprecedented flexibility to improve the reliability of electricity service in future power systems. However, due to the uncertainties arising from the demand side, the extent to which DR can be utilized for capacity support poses a major question to the utilities. To address this issue, this paper proposes a new methodological framework to assess the potential reliability value of DR in smart grids. The framework is established on the concept of capacity credit (CC), and it accommodates different types of uncertainties (i.e., probabilistic and possibilistic) accrued from physical and anthropogenic factors in DR programs. The capability of DR during operation is considered as a synthesized result of multiple facets, i.e., users’ load characteristics, participation levels, and load recoveries, and different models are developed to represent each component. To characterize the stochastic nature of demand responsiveness, the fuzzy theory is introduced, and possibilistic models are proposed to describe the human-related uncertainties under incomplete information. In addition, considering that in reality, DR operation could affect the comfort of customers, the dynamics of demand-side participation have also been incorporated in our study, in which two utility-based indices are defined to quantify the effect of such interdependency. Using a probabilistic propagation technique, the different types of uncertainties involved can be normalized and systematically addressed under the same framework. Then, the relevant models can be applied to the CC evaluation procedures, wherein two dispatching schemes (i.e., reliability-driven and coordinated management) are considered to study the effect of DR operation on its CC. The proposed methodology is tested on a modified RTS system, and the obtained results confirm its effectiveness.}
}
@article{ANAND1986100,
title = {Computer assisted models used in the solution of warehouse location-allocation problems},
journal = {Computers & Industrial Engineering},
volume = {11},
number = {1},
pages = {100-104},
year = {1986},
issn = {0360-8352},
doi = {https://doi.org/10.1016/0360-8352(86)90057-4},
url = {https://www.sciencedirect.com/science/article/pii/0360835286900574},
author = {S. Anand and Kenneth Knott},
abstract = {This paper presents a general overview of the various types of computer based algorithms solving the Warehouse Location-Allocation problem. Available heuristic algorithms are compared with exact optimization models for accuracy of the solution and time to make the computer runs. Salient features and applicability of the various models are presented. A review of the available software to solve this type of problem is given. Finally, the future trends in developing models to solve these problems is discussed.}
}
@incollection{VILAR1987185,
title = {Evaluation of Urban Distribution Systems Reliability},
editor = {SAMY G. KRISHNASAMY},
booktitle = {Probabilistic Methods Applied to Electric Power Systems},
publisher = {Pergamon},
pages = {185-193},
year = {1987},
isbn = {978-0-08-031874-5},
doi = {https://doi.org/10.1016/B978-0-08-031874-5.50024-3},
url = {https://www.sciencedirect.com/science/article/pii/B9780080318745500243},
author = {J.P. VILAR and M.O. VEGA},
keywords = {Reliability evaluation, failure rate, electrical distribution systems, reliability of capacitated networks},
abstract = {ABSTRACT
A new algorithm of reliability evaluation for urban distribution systems is presented. Other than classical considerations such as alternate feeding, switching times and radial operation, two non-conventional aspects are included. The first one is a time dependent spare capacity of alternate feeds to take into account the daily cyclic loading of circuits. The second one distinguishes a time dependent risk of failure of components to take into account the statistical data of failure occurrence on a daily cycle basis. These aspects show to have a significant impact on load point reliability indices particularly in the power and energy curtailed expected values.}
}
@incollection{GHAREHPETIAN202513,
title = {Chapter 2 - Main challenges of generation, transmission, and distribution systems},
booktitle = {Future Power System Elements, Challenges, and Solutions},
publisher = {Academic Press},
pages = {13-46},
year = {2025},
isbn = {978-0-443-14091-4},
doi = {https://doi.org/10.1016/B978-0-443-14091-4.00003-4},
url = {https://www.sciencedirect.com/science/article/pii/B9780443140914000034},
author = {Gevork B. Gharehpetian and Mahdi Zolfaghari and Navid Bayati},
keywords = {Distribution, Generation, Power system challenges, Transmission},
abstract = {In this chapter, main challenges of generation, transmission, and distribution systems were presented. Firstly, the conventional power system topology was discussed. It was mentioned that a typical power system is based on three main sections: generation, transmission and sub-transmission, and distribution. To investigate the transmission system challenges, firstly, the topologies of the transmission systems were studied. These structures were divided into two groups: networks with long transmission lines and networks with meshed transmission systems. Their challenges were different. In networks with long transmission lines, there was a considerable difference between the thermal limit of the line and the transient stability limit. This means that the utilities could not use the transmission line full rating, but they should invest and install this transmission line with its high rating (thermal limit). In the meshed transmission systems, the power flows from unwanted lines/paths were considered as their main problem. This means that the power flow calculations dictate the power that flows in each transmission line (power flow pattern). To change the power flow pattern, there are some conventional solutions for this issue, namely, installation of a new line, changing the line characteristics, installation of series and parallel capacitors, and application of phase shifting transformers. Also, there are new solutions based on power electronic devices, which will be discussed in the coming chapters. To study the challenges in existing distribution systems, their structure was presented first. It was mentioned that a typical distribution system has four layers; distribution substation, primary feeders, distribution transformers, and costumers. Also, the main properties of distribution system were presented from designer point of view.}
}
