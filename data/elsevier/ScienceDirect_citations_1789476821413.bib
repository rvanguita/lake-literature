abstract = {The European Union (EU) 2020 Energy Strategy calls for reducing the EU’s greenhouse gas emissions, increasing the share of renewable energy, and achieving significant energy savings. All EU countries must also increase the share of renewable energy in their transport sectors. EU Member States are at various stages of compliance. This chapter analyses the situations in Slovenia. It analyses relevant governance structures in each country and identifies where regulation is conducive to the above goals and where it is acting as a barrier. Given that deregulation and decentralization are part of achieving the EU’s energy strategy, the chapter examines where Slovenia stands on that front and what specific initiatives and projects are underway toward greater deregulation and decentralization. Such initiatives include rollouts of smart metering systems and electric vehicles as well as launching demand response schemes. The chapter also addresses relevant data protection concerns.}
}
@article{CARVALLO2020115071,
title = {The economic value of a centralized approach to distributed resource investment and operation},
journal = {Applied Energy},
volume = {269},
pages = {115071},
year = {2020},
issn = {0306-2619},
doi = {https://doi.org/10.1016/j.apenergy.2020.115071},
url = {https://www.sciencedirect.com/science/article/pii/S0306261920305833},
author = {Juan Pablo Carvallo and Nan Zhang and Sean P. Murphy and Benjamin D. Leibowicz and Peter H. Larsen},
keywords = {Distributed energy resources, Decentralized decision-making, Electricity rate structure, Power system, Resource planning, Rooftop solar},
abstract = {Distributed energy resources have been almost exclusively deployed and operated under a decentralized decision-making process. In this paper, we assess the evolution of a power system with centrally planned utility-scale generation, transmission, distribution, and distributed resources. We adapt a capacity expansion model to represent both centralized and decentralized decision-making paradigms under various electricity rate structures. This paper shows that a centralized planning approach could save 7% to 37% of total system costs over a 15-year time horizon using a Western United States utility as a case study. We show that centralized decision-making deploys substantially more utility-scale solar and distributed storage compared to a decentralized decision-making paradigm. We demonstrate how a utility could largely overcome the complications of decentralized distributed resource decision-making by incentivizing regulators to develop electricity rates that more closely reflect time- and location-specific, long-run marginal costs. The results from this analysis yield insights that are useful for long-term utility planning and electric utility rate design.}
}
@article{PHAM2025107347,
title = {A modified distribution flow-based quadratic programming with integer variables for co-optimization of on-site generation placement and network topology in power distribution grids},
journal = {Results in Engineering},
volume = {28},
pages = {107347},
year = {2025},
issn = {2590-1230},
doi = {https://doi.org/10.1016/j.rineng.2025.107347},
url = {https://www.sciencedirect.com/science/article/pii/S2590123025034024},
author = {Nang-Van Pham and Hoai-Nam Nguyen},
keywords = {Electricity distribution grids, OSG unit allocation, Network reconfiguration, Overall power loss, Modified distribution flow (MD) model, Quadratic programming with integer variables (MIQP)},
abstract = {This paper focuses on computing the optimum position and capacity of on-site generation (OSG) units in conjunction with grid reconfiguration in electrical distribution grids. The minimized goal function is the overall active power loss in electrical distribution systems. The identified constraints include equations of power balance, voltage magnitude limits, the quantity of buses designated for OSG unit installation, active power restrictions for each OSG unit, limitations of power flowing through branches, and radial topology requirements. The suggested optimization formulation is a complex mixed-integer nonlinearly constrained optimization (MINLP). This MINLP formulation is reformulated as a problem of quadratic programming with integer variables (MIQP) by using the modified distribution flow technique and exactly linearized expressions of multiplying a continuous variable by a binary variable, which may be effectively solved using the CPLEX business-oriented optimizer under the GAMS programming environment. The modified distribution flow, whose state variables, such as real power as well as reactive power, are substituted with their proportions to the magnitude of nodal voltage, constitutes a branch load flow framework that is linear and does not require initial operating points. The benchmark test distribution systems, including 33, 59, 69, and 70 nodes, together with a realistic Vietnamese 190-bus grid, are used to examine the concurrent impacts of optimal OSG allocation and optimum grid topology on real power loss, together with voltage profiles, utilizing the suggested model. Three distinct scenarios are meticulously contrasted and analyzed: only optimal network topology (only ONT), only optimal allocation of OSG units (only OPOSG), and the combined optimization of OSG placement and grid topology (ONT and OPOSG). The results demonstrate that the proposed MIQP model achieves up to a 94.30% reduction in power loss while also enhancing voltage patterns. The proposed optimization framework proves to be a highly effective and scalable solution, making it a valuable and practical tool for enhancing the performance of electrical distribution systems.}
}
@article{KRISHNAN2015175,
title = {Optimal allocation of energy storage in a co-optimized electricity market: Benefits assessment and deriving indicators for economic storage ventures},
