url = {https://www.sciencedirect.com/science/article/pii/S1877050924029107},
author = {Zhixuan Zhao and Haisheng Hong and Yan Deng and Xiaojie Lv and Haitao Chen and Hanyu Li},
keywords = {Microgrid regulation, electricity power distribution networks, deep reinforcement learning, deterministic policy gradient},
abstract = {This paper exploited the distributed reactive power compensation and optimization adjustments. Firstly, based on electrical distance, a dynamic partitioning strategy for the distribution network is formulated using the dynamic decomposition method. Then, in the modeling of reactive power dynamic adjustment within the sub-region, the expected value of active power loss obtained by the probabilistic power flow calculation method is used as the objective function, and an improved genetic algorithm is used for the solution. Through using MATLAB software programming and the IEEE 33-bus test distribution system as an example for experimental analysis, the effectiveness and feasibility of the proposed method were verified through the analysis and comparison of experimental results.}
}
