@incollection{MIRI2026293,
title = {Chapter 8 - Demand-side uncertainty and planning for flexibility provision},
editor = {Miadreza Shafie-khah},
booktitle = {Stochastic Planning and Modeling for Energy Systems},
publisher = {Elsevier},
pages = {293-330},
year = {2026},
isbn = {978-0-443-45298-7},
doi = {https://doi.org/10.1016/B978-0-443-45298-7.00006-9},
url = {https://www.sciencedirect.com/science/article/pii/B9780443452987000069},
author = {Seyed Pouria Miri and Mohammad Hossein Shaabani and Hamid Reza {Pilehvar Javid} and Mohammad Hossein Alizadeh Roknabadi and Hamid Reza Baghaee and Gevork B. Gharehpetian},
keywords = {Energy application, Energy economics, Energy systems, Multiagent system, Power engineering, Urban planning},
abstract = {Rising shares of variable renewables, demand electrification, and decentralized generation have amplified demand‑side uncertainty in modern power systems. This chapter characterizes heterogeneous sources of demand variability across residential, commercial, industrial, and agricultural sectors and traces their implications for reliability, frequency/voltage stability, operating cost, and long‑term network development. It consolidates competing definitions of “flexibility” and delineates four dimensions—energy, power, voltage, and transfer‑capacity flexibility. Flexibility resources are cataloged across five portfolios (generation‑side, grid‑side, demand‑side, energy storage systems (ESS), and policy/regulation), together with quantitative assessment via technical indices (e.g., ramp rates, reserves, peak reduction, self‑sufficiency) and cost‑based metrics. For distribution systems, the chapter outlines planning strategies under uncertainty, including co‑siting/sizing of distributed energy resource (DER) and ESS, integration of demand-side management (DSM)/demand response (DR), and market‑based approaches such as local flexibility markets (LFMs), aggregator participation, price‑maker versus price‑taker behavior, and distribution system operators (DSO)–transmission system operators (TSO) coordination. Emerging options—vehicle‑to‑grid, power‑to‑heat, microgrids, and peer‑to‑peer trading—are assessed alongside lessons from European pilots (PicloFlex, Enera, GOPACS, NODES) on product design, settlement, and institutional coordination. The chapter closes by identifying research gaps (planning‑oriented metrics and market architecture) and recommending that “flexibility maximization” be elevated to an explicit objective in distribution expansion planning.}
}
@article{ALVAREZHERAULT2012148,
title = {Optimizing traditional urban network architectures to increase distributed generation connection},
journal = {International Journal of Electrical Power & Energy Systems},
volume = {35},
number = {1},
pages = {148-157},
year = {2012},
issn = {0142-0615},
doi = {https://doi.org/10.1016/j.ijepes.2011.10.007},
url = {https://www.sciencedirect.com/science/article/pii/S0142061511002341},
author = {M.-C. Alvarez-Herault and R. Caire and B. Raison and N. HadjSaid and W. Bienia},
keywords = {Distributed generation, Distribution network, Optimization, Planning, Traveling Salesman Problem, Linear programming},
abstract = {Distribution networks have always been planned for end users and without many concerns about distributed generations. Their function is to supply all the consumers ensuring good continuity of supply and service quality. Following this objective, distribution network operators converge to a small amount of architectures and operation rules depending on the degree of service quality and the initial investment desired. An increasing connection of distributed generations to the distribution network raises technical problems and brings planning rules to be no more optimal. Business as usual solutions currently used are not economic and may finally become insufficient. A deep review of existing planning tools should be required to find efficient solutions to increase the distributed generation interconnection. This paper proposes a heuristic method able to optimize current French architecture features (amount of feeders, choice of consumers connected to them) in order to increase distributed generation penetration. A real urban network has been used to validate this methodology.}
}