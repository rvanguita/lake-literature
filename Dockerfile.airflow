# Airflow's own Python environment never needs to match the project's --
# `uv` (a static, dependency-free binary) manages Python 3.13 + all project
# deps independently inside this container, so we just need `uv` present.
FROM apache/airflow:3.3.1-python3.12

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Pre-create the uv-managed venv dir owned by the airflow user (uid 50000,
# gid 0) -- Docker copies a named volume's initial content/permissions from
# the image on first mount, which avoids a permission-denied error when uv
# tries to create the venv under a root-owned empty volume.
USER root
RUN mkdir -p /opt/venv-airflow && chown airflow:0 /opt/venv-airflow
USER airflow
